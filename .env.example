# Optional portable dataset source.
# Put a Roboflow Universe YOLOv8 zip URL here and future users can run:
#   python scripts/setup.py
#
# Keep real private/API-key URLs in .env, not in Git.
ROBOFLOW_EXPORT_URL=

# Optional Groq key for VQA.
GROQ_API_KEY=

# Optional voice transcription provider.
# auto tries Groq whisper-large-v3-turbo, then whisper-large-v3, then AssemblyAI.
TRANSCRIBE_PROVIDER=auto
GROQ_TRANSCRIBE_MODELS=whisper-large-v3-turbo,whisper-large-v3
ASSEMBLYAI_API_KEY=
# ASS_API= also works if you prefer that name.
ASSEMBLYAI_SPEECH_MODELS=universal-3-pro
